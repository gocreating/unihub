COMPOSE_PROJECT_NAME=unihub

# Django backend
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:5173

# PostgreSQL
POSTGRES_USER=unihub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=unihub
DATABASE_URL=postgresql://unihub:change-me@db:5432/unihub

# Superuser auto-creation (optional — set to create an admin on first boot)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=
