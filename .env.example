# Copy this file to apps/unihub/.env and fill in real values before running
# the production compose stack.  Never commit a .env file with real secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=unihub
POSTGRES_PASSWORD=change-me

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me

# Comma-separated list of allowed hostnames (no scheme, no port)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (with scheme + port) allowed for CORS and CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Production image tags ─────────────────────────────────────────────────────
# Set these to the tags you pushed before running docker-compose.production.yml
BACKEND_IMAGE=unihub-backend:latest
FRONTEND_IMAGE=unihub-frontend:latest

# Host port the frontend is exposed on
FRONTEND_PORT=80
